# ===== База даних =====
# PostgreSQL (Neon) або SQLite за замовчуванням для локального запуску
DATABASE_URL=sqlite:///./data/threats.db

# ===== Ключі API для джерел =====

# Опційно: для вищих лімітів NVD API
# Отримати безкоштовно: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Опційно: підіймає ліміт GitHub Search API з 10 до 30 запитів/хв (GitHub PoC-фід)
# Створити: https://github.com/settings/tokens (без прав, тільки public repo read)
GITHUB_TOKEN=

# Обов'язково для ThreatFox і MalwareBazaar (IOC/семпли): abuse.ch вимагає безкоштовний ключ
# Отримати: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Опційно: для AlienVault OTX (IoC/pulses)
# Отримати: https://otx.alienvault.com/ (профіль → API key)
OTX_API_KEY=

# ===== Інтеграції =====

# Опційно: webhook n8n для автопублікації зведення в Telegram після кожного запуску pipeline
# Порожньо = не надсилати. Вставити URL Webhook з n8n, напр. https://n8n.example.com/webhook/...
N8N_WEBHOOK_URL=

# Обов'язково: DDoS-статистика Cloudflare Radar (таблиця ddos_snapshots, /ddos-stats*)
# Порожньо = колектор пропускається, API повертає 404, доки немає даних.
# Безкоштовний токен: https://dash.cloudflare.com/profile/api-tokens (Read - Radar)
CLOUDFLARE_RADAR_API_TOKEN=

# Обов'язково: AI-аналіз (Groq API) — digest, DDoS, IOC, Vendor, Phishing examples
# Отримати: https://console.groq.com/keys (безкоштовний тариф з обмеженнями)
GROQ_API_KEY=

# Опційно: Telegram-бот для каналів (СБУ/SSSCIP/Кіберполіція/Кіберпартизани)
# Токен: @BotFather → /newbot. Додати бота адміном до каналів.
# TELEGRAM_CHANNELS — юзернейми через кому, напр. "@sbu_gov_ua,@dsszzi"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=

# ===== Google Safe Browsing (перевірка URL на фішинг/малварь) =====
# Безкоштовний тариф: 10 000 запитів/день
# Отримати: https://console.cloud.google.com/apis/credentials (GCP project → API key)
# Увімкнути: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=

# ===== Have I Been Pwned (витоки даних) =====
# API v3: список breaches працює без ключа, пошук по email — платний ($3.50/міс)
# Отримати: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ===== VirusTotal (IoC, файли, URL) =====
# Безкоштовний тариф: 4 запити/хв, 500 запитів/день
# Використання: 2 запити/день (URL feed + file feed) = 60/міс (0.4% ліміту)
# Отримати:
#   1) Зареєструйтесь: https://www.virustotal.com/gui/join-us
#   2) Перейдіть: https://www.virustotal.com/gui/my-apikey
#   3) Скопіюйте API key
VIRUSTOTAL_API_KEY=

# ===== Intelligence X (пошук по утечкам, даркнету) =====
# Free tier з лімітами
# Отримати:
#   1) Зареєструйтесь: https://intelx.io/
#   2) Перейдіть: Settings → API
#   3) Отримайте API key (free tier з лімітами)
INTELX_API_KEY=

# ===== Shodan (пошук по хостах/сервісах) =====
# Free tier: 1 запит/сек, 100 запитів/міс
# Використання: 1 запит/день = 30/міс (30% ліміту) — безпечний запас
# Отримати:
#   1) Зареєструйтесь: https://account.shodan.io/register
#   2) Перейдіть: https://account.shodan.io/
#   3) Скопіюйте API Key
# ⚠️ Free tier обмежений: тільки basic search, без internetdb, без historical
SHODAN_API_KEY=

# ===== Censys (пошук по хостах/сервісах) =====
# Free tier обмежений
# Отримати: https://search.censys.io/
CENSYS_API_ID=
CENSYS_API_SECRET=

# ===== Фонове збирання даних (scheduled pipeline) =====
# Автоматичний запуск python -m app.pipeline у фоні (за замовчуванням УВІМКНЕНО).
# 0/v_false — вимкнути (збирання тільки вручну).
ENABLE_COLLECT_SCHEDULER=1
# Як часто оновлювати базу, годин (типово 1 = щогодини).
COLLECT_INTERVAL_HOURS=1

# ===== Кеш атрибуції (швидкість /stats) =====
# Скільки секунд тримати в пам'яті розрахунок actor→sponsor→infra.
# Скидається і раніше, якщо змінилася БД (COUNT + MAX(fetched_at)).
ATTRIB_CACHE_TTL_SEC=300

# ===== Ретрай AI-аналізів =====
# Якщо якийсь із 5 AI-аналізів (digest/ddos/ioc/vendor/ukraine) не згенерувався
# (Groq 429 rate limit, таймаут) — фоновий планувальник повторює САМЕ його,
# доки не з'явиться в кеші. Інакше /ai/* віддавав 503 аж до 09:00 KYIV.
# Хвилин між спробами (мінімум 1). Порожньо або 0 → дефолт 15.
AI_RETRY_MINUTES=15
